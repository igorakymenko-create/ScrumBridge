{
  "name": "scrumbridge",
  "version": "0.3.0",
  "description": "ScrumBridge: chat + MCP server that connects the team's decisions and plan to an IDE agent",
  "license": "Apache-2.0",
  "author": "Igor Akymenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorakymenko-create/ScrumBridge.git"
  },
  "homepage": "https://github.com/igorakymenko-create/ScrumBridge#readme",
  "bugs": {
    "url": "https://github.com/igorakymenko-create/ScrumBridge/issues"
  },
  "type": "module",
  "bin": {
    "scrumbridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "tsc && node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "^2.1.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "public",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "ai-agents",
    "scrum",
    "llm",
    "claude-code",
    "ide",
    "planning"
  ]
